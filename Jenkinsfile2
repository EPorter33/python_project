pipeline {
   agent any

    stages {
        stage('Checkout') {
            steps {
                echo 'Downloading Python project from GitHub'

                git branch: 'main',
                    url: 'https://github.com/bassam2080/python_project.git'
            }
        }

        stage('Build') {
            steps {
                echo 'Checking Python application'

                sh 'python3 --version'
                sh 'python3 -m py_compile script1.py'
            }
        }

        stage('Run Script') {
            steps {
                echo 'Running Python application'

                sh 'python3 script1.py'
            }
        }
    }

    post {
        always {
            echo 'Cleaning workspace'
            cleanWs()
        }

        success {
            echo 'Pipeline completed successfully!'
        }

        failure {
            echo 'Pipeline failed!'
        }
    }
}
