
pipeline {
    agent {
        label 'built-in'
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/bassam2080/python_project.git'
            }
        }

        stage('Setup Python') {
            steps {
                sh '''
                    if command -v python3 >/dev/null 2>&1; then
                        echo "Python3 is already installed"
                        python3 --version
                    else
                        echo "Python3 is missing"
                        echo "Install Python in the Jenkins execution environment"
                        exit 1
                    fi
                '''
            }
        }

        stage('Build') {
            steps {
                sh 'python3 -m py_compile script1.py'
            }
        }

        stage('Run Script') {
            steps {
                sh 'python3 script1.py'
            }
        }

        stage('Cleaning') {
            steps {
                echo 'Cleaning stage completed'
            }
        }
    }
}
