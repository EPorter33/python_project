pipeline {
    agent {
        label 'python-agent-template'
    }

    options {
        skipDefaultCheckout(true)
    }
       stages {
        stage('Checkout') {
            steps {
                echo 'Downloading Python project from GitHub'
                checkout scm
                sh 'ls -la'
                  }
               }
        stage('Build') {
            steps {
                echo 'Building the Python application'

                sh 'python3 -m compileall -q script1.py'
                sh 'tar -czf python-app.tar.gz script1.py'
            }
        }
        stage('Setup Test Environment') {
                steps {
            echo 'Installing pytest'

                sh '''
                    python3 -m venv .venv
                    .venv/bin/python -m pip install pytest
                '''
    }
}

         stage('Unit Testing') {
                steps {
                  echo 'Running Python unit tests'

               sh '''
            mkdir -p test-results
            .venv/bin/python -m pytest -v test_script2.py \
                --junitxml=test-results/results.xml
        '''
                      }
        }
        stage('Run') {
            steps {
                echo 'Running the Python application'

                sh 'python3 script1.py'
            }
        }
         
    }

  
post {
        always {
            junit testResults: 'test-results/results.xml',
                  skipPublishingChecks: true

            archiveArtifacts artifacts: 'test-results/results.xml',
                             allowEmptyArchive: true
        }

        failure {
            echo 'Pipeline failed!'
        }
    }
}
        
